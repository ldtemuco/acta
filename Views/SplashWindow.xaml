<Window x:Class="ACTA.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1100"
        Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border CornerRadius="16"
            Background="White">

        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                ShadowDepth="4"
                Opacity="0.35"/>
        </Border.Effect>

        <Grid>

            <!-- Imagen principal -->
            <Image Source="/Assets/splash-acta.png"
                   Stretch="UniformToFill"/>

            <!-- Panel inferior para carga real -->
            <Border
                VerticalAlignment="Bottom"
                Height="78"
                Background="#EFFFFFFF"
                CornerRadius="0,0,16,16">

                <StackPanel
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="380">

                    <ProgressBar
                        x:Name="LoadingProgress"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Height="10"
                        BorderThickness="0">

                        <ProgressBar.Resources>

                            <Style TargetType="ProgressBar">

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="ProgressBar">

                                            <Grid>

                                                <!-- Fondo -->
                                                <Border
                                                    Background="#D8D8D8"
                                                    CornerRadius="5"/>

                                                <!-- Progreso -->
                                                <Grid
                                                    x:Name="PART_Track"
                                                    ClipToBounds="True">

                                                    <Border
                                                        x:Name="PART_Indicator"
                                                        HorizontalAlignment="Left"
                                                        Background="#F28C00"
                                                        CornerRadius="5"/>

                                                </Grid>

                                            </Grid>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </ProgressBar.Resources>

                    </ProgressBar>

                    <TextBlock
                        x:Name="StatusText"
                        Text="Iniciando ACTA..."
                        Margin="0,9,0,0"
                        FontSize="14"
                        Foreground="#404040"
                        HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</Window>