<Window x:Class="ACTA.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/Icons/Acta-Icon.ico"
        Title="Historial de actas"
        Width="1100"
        Height="650"
        MinWidth="850"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    Text="Historial de actas"
                    FontSize="24"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Margin="0,4,0,0"
                    Text="Consulta las actas almacenadas en la base de datos."
                    Foreground="#666666"/>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Bottom">

                <TextBox
                    x:Name="SearchTextBox"
                    Width="280"
                    Height="34"
                    Margin="0,0,8,0"
                    Padding="8,5"
                    VerticalContentAlignment="Center"
                    TextChanged="SearchTextBox_TextChanged"/>

                <Button
                    Width="100"
                    Height="34"
                    Content="Actualizar"
                    Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Tabla -->
        <Border
            Grid.Row="2"
            BorderBrush="#D8D8D8"
            BorderThickness="1"
            CornerRadius="4">

            <DataGrid
                x:Name="HistoryDataGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                IsReadOnly="True"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                MouseDoubleClick="HistoryDataGrid_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="ID"
                        Binding="{Binding Id}"
                        Width="70"/>

                    <DataGridTextColumn
                        Header="Fecha"
                        Binding="{Binding DateTime, StringFormat={}{0:dd/MM/yyyy}}"
                        Width="120"/>

                    <DataGridTextColumn
                        Header="Hora"
                        Binding="{Binding DateTime, StringFormat={}{0:HH:mm}}"
                        Width="90"/>

                    <DataGridTextColumn
                        Header="Participantes"
                        Binding="{Binding ParticipantCount}"
                        Width="120"/>

                    <DataGridTextColumn
                        Header="Motivo"
                        Binding="{Binding Motives}"
                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter
                                    Property="TextTrimming"
                                    Value="CharacterEllipsis"/>
                                <Setter
                                    Property="VerticalAlignment"
                                    Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- Botones inferiores -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="RecordCountTextBlock"
                VerticalAlignment="Center"
                Foreground="#666666"/>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">

                <Button
                    Width="100"
                    Height="36"
                    Margin="0,0,8,0"
                    Content="Eliminar"
                    Click="DeleteButton_Click"/>               

                <Button
                    Width="100"
                    Height="36"
                    Content="Cerrar"
                    Click="CloseButton_Click"/>

            </StackPanel>
        </Grid>

    </Grid>
</Window>