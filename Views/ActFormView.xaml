<UserControl x:Class="ACTA.Views.ActFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"            
             MinWidth="500">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Grid.Row="0"
                       Text="Nueva Acta"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,24"/>

            <!-- Datos generales -->
            <Grid Grid.Row="1"
                  Margin="0,0,0,24">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Fecha -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fecha" Margin="0,0,0,6" FontSize="16"/>
                    <DatePicker x:Name="MeetingDatePicker" 
                                Height="32" 
                                FontSize="18"
                                Style="{StaticResource DatePickerIconResizingStyle}"/>
                </StackPanel>

                <!-- Hora -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hora (Formato 24H)" Margin="0,0,0,6" FontSize="16"/>
                    <TextBox x:Name="MeetingTimeTextBox"
                     Height="32"
                     Width="70"
                     MaxLength="5"
                     FontSize="18"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Left"
                     ToolTip="Formato HH:mm" HorizontalAlignment="Left"/>
                </StackPanel>


            </Grid>




            <!-- Participantes -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,24">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Margin="0,0,0,10">

                    <TextBlock Text="Participantes"
                        FontSize="16"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                    <TextBlock x:Name="ParticipantCountTextBlock"
                       Text="0"        
                       Margin="100,0,0,0"
                       FontSize="16"
                       FontWeight="Bold"        
                       VerticalAlignment="Center"/>

                    <Button x:Name="AddParticipantButton"
                            Content="+ Agregar"
                            Width="100"
                            Height="30"
                            FontSize="16"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right"
                            Click="AddParticipantButton_Click"/>
                </DockPanel>

                <!-- ItemsControl -->
                <Border Grid.Row="1"
                    BorderBrush="#D0D0D0"
                    BorderThickness="3"
                    CornerRadius="4"
                    MinHeight="90"                      
                    Padding="12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84*"/>
                            <ColumnDefinition Width="127*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mensaje cuando la colección está vacía -->
                        <TextBlock Text="Todavía no hay participantes."
                            Foreground="#777777"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="134,0,0,0">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=ParticipantsItemsControl,Path=HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>

                        <!-- Participantes -->
                        <ItemsControl x:Name="ParticipantsItemsControl" ItemsSource="{Binding Participants, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="16" Grid.ColumnSpan="2"  >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32*"/>
                                            <ColumnDefinition Width="50*"/>
                                            <ColumnDefinition Width="13*"/>
                                            <ColumnDefinition Width="14*"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Nombre -->
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,8,0"/>
                                        <!-- Rol -->
                                        <TextBlock Grid.Column="1" Text="{Binding Role}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,8,0"/>
                                        <!-- RUN -->
                                        <TextBlock Grid.Column="2" Text="{Binding Run}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,8,0"/>
                                        <!-- Teléfono -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4">
                                            <TextBlock Text="+56 9 "/>
                                            <TextBlock Text="{Binding Phone}"/>
                                        </StackPanel>
                                        <!-- Acciones -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Button Content="Editar"
                                                Height="28"
                                                Margin="4,0"
                                                Padding="8,0"
                                                Click="EditParticipantButton_Click"/>

                                            <Button Content="Eliminar"
                                                Height="28"
                                                Margin="4,0"
                                                Padding="8,0"
                                                Click="RemoveParticipantButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- Motivos -->
            <StackPanel Grid.Row="3"
                        Margin="0,0,0,20">

                <TextBlock Text="Motivos"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="MotivesTextBox"
                         MinHeight="90"
                         Padding="8"
                         AcceptsReturn="True"
                         BorderThickness="3"
                         TextWrapping="Wrap"
                         MaxLength="750"
                         VerticalScrollBarVisibility="Auto"
                         PreviewTextInput="ActTextBox_PreviewTextInput"
                         PreviewKeyDown="ActTextBox_PreviewKeyDown"
                         TextChanged="ActTextBox_TextChanged"/>

            </StackPanel>

            <!-- Acuerdos -->
            <StackPanel Grid.Row="4"
                        Margin="0,0,0,20">

                <TextBlock Text="Acuerdos"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="AgreementsTextBox"
                         MinHeight="90"
                         Padding="8"
                         AcceptsReturn="True"
                         BorderThickness="3"
                         TextWrapping="Wrap"
                         MaxLength="750"
                         VerticalScrollBarVisibility="Auto"
                         PreviewTextInput="ActTextBox_PreviewTextInput"
                         PreviewKeyDown="ActTextBox_PreviewKeyDown"
                         TextChanged="ActTextBox_TextChanged"/>

            </StackPanel>

            <!-- Compromisos + botones -->
            <StackPanel Grid.Row="5">

                <TextBlock Text="Compromisos"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="CommitmentsTextBox"
                         MinHeight="90"
                         Padding="8"
                         AcceptsReturn="True"
                         BorderThickness="3"
                         TextWrapping="Wrap"
                         MaxLength="750"
                         VerticalScrollBarVisibility="Auto"
                         PreviewTextInput="ActTextBox_PreviewTextInput"
                         PreviewKeyDown="ActTextBox_PreviewKeyDown"
                         TextChanged="ActTextBox_TextChanged"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button x:Name="PreviewButton"
                            Content="Vista previa"
                            FontSize="16"
                            Width="110"
                            Height="34"
                            Margin="0,0,10,0"/>

                    <Button x:Name="SaveButton"
                            FontSize="16"
                            Content="Guardar acta"
                            Width="110"
                            Height="34"/>

                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>