<UserControl x:Class="ACTA.Views.ActFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"            
             MinWidth="500">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Grid.Row="0"
                       Text="Nueva acta"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,24"/>

            <!-- Datos generales -->
            <Grid Grid.Row="1"
                  Margin="0,0,0,24">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Fecha -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fecha" Margin="0,0,0,6" FontSize="16"/>
                    <DatePicker x:Name="MeetingDatePicker" 
                                Height="32" 
                                FontSize="18"
                                Style="{StaticResource DatePickerIconResizingStyle}"/>
                </StackPanel>

                <!-- Hora -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hora (Formato 24H)" Margin="0,0,0,6" FontSize="16"/>
                    <TextBox x:Name="MeetingTimeTextBox"
                     Height="32"
                     Width="70"
                     MaxLength="5"
                     FontSize="18"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Left"
                     ToolTip="Formato HH:mm" HorizontalAlignment="Left"/>
                </StackPanel>
               

            </Grid>

            <!-- Participantes -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,24">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Margin="0,0,0,10">

                    <TextBlock Text="Participantes"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button x:Name="AddParticipantButton"
                            Content="+ Agregar"
                            Width="100"
                            Height="30"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right"
                            Click="AddParticipantButton_Click"/>
                </DockPanel>

                <!-- Aquí irá el ItemsControl -->
                <Border Grid.Row="1"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="4"
                        MinHeight="90"
                        Padding="12">

                    <TextBlock Text="Todavía no hay participantes."
                               Foreground="#777777"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

            </Grid>

            <!-- Motivos -->
            <StackPanel Grid.Row="3"
                        Margin="0,0,0,20">

                <TextBlock Text="Motivos"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="MotivesTextBox"
                         MinHeight="90"
                         Padding="8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

            </StackPanel>

            <!-- Acuerdos -->
            <StackPanel Grid.Row="4"
                        Margin="0,0,0,20">

                <TextBlock Text="Acuerdos"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="AgreementsTextBox"
                         MinHeight="90"
                         Padding="8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

            </StackPanel>

            <!-- Compromisos + botones -->
            <StackPanel Grid.Row="5">

                <TextBlock Text="Compromisos"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="CommitmentsTextBox"
                         MinHeight="90"
                         Padding="8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button x:Name="PreviewButton"
                            Content="Vista previa"
                            Width="110"
                            Height="34"
                            Margin="0,0,10,0"/>

                    <Button x:Name="SaveButton"
                            Content="Guardar acta"
                            Width="110"
                            Height="34"/>

                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>