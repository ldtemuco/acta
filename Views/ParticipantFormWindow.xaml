<Window x:Class="ACTA.Views.ParticipantFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar participante"
        Width="420"
        Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nombre -->
        <StackPanel Grid.Row="0"
            Margin="0,0,0,14">

            <TextBlock Text="Nombre"
                FontSize="16"
                FontWeight="Bold"
                Margin="0,0,0,5"/>

            <TextBox x:Name="NameTextBox"
                Height="32"
                FontSize="16"
                BorderThickness="3"     
                VerticalContentAlignment="Center"
                TextChanged="Field_TextChanged"/>

        </StackPanel>

        <!-- Rol -->
        <StackPanel Grid.Row="1"
            Margin="0,0,0,14">

            <TextBlock Text="Rol"
                FontSize="16"
                FontWeight="Bold"
                Margin="0,0,0,5"/>

            <TextBox x:Name="RoleTextBox"
                Height="32"
                FontSize="16"
                BorderThickness="3"       
                VerticalContentAlignment="Center"
                TextChanged="Field_TextChanged"/>

        </StackPanel>

        <!-- RUN -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">

            <TextBlock 
                Text="RUN"
                FontSize="16"
                FontWeight="Bold"
                Margin="0,0,0,5"/>

            <TextBox x:Name="RunTextBox"
                Height="32"
                FontSize="16"
                BorderThickness="3"       
                VerticalContentAlignment="Center" 
                Width="128" 
                HorizontalAlignment="Left"
                MaxLength="13"
                PreviewTextInput="RunTextBox_PreviewTextInput"
                TextChanged="RunTextBox_TextChanged"
                LostFocus="RunTextBox_LostFocus"/>

        </StackPanel>

        <!-- Teléfono -->
        <StackPanel Grid.Row="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Etiqueta -->
                <TextBlock Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="Teléfono"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,0,0,5"/>

                <!-- Prefijo fijo -->
                <TextBlock Grid.Row="1"
                    Grid.Column="0"
                    Text="+56 9"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,0,8,0"/>

                <!-- Número -->
                <TextBox x:Name="PhoneTextBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="32"
                    FontSize="16" 
                    MaxLength="8"
                    BorderThickness="3"     
                    VerticalContentAlignment="Center" 
                    Margin="0,0,220,0" 
                    TextChanged="Field_TextChanged"/>

            </Grid>
        </StackPanel>

        <!-- Botones -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">

            <Button x:Name="CancelButton"
                    Content="Cancelar"
                    Width="90"
                    Height="32"
                    Margin="0,0,10,0"
                    IsCancel="True"/>

            <Button x:Name="AddButton"                
                    Content="Agregar"
                    Width="90"
                    Height="32"
                    IsDefault="True"
                    Click="AddButton_Click"/>

        </StackPanel>
    </Grid>
</Window>