<Window x:Class="ACTA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ACTA.Views"
        xmlns:controls="clr-namespace:ACTA.Views.Controls"
        Icon="/Resources/Icons/Acta-Icon.ico"
        Title="ACTA"
        Width="1100"
        Height="900"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16,10"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1">

            <StackPanel Orientation="Horizontal">

                <Button x:Name="NewActButton"
                    Content="Nueva acta"
                    Width="110"
                    Height="34"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,0,10,0"
                    Click="NewActButton_Click"/>

                <Button x:Name="ExportButton"
                    Content="Exportar"
                    Width="110"
                    Height="34"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"
                    Click="ExportButton_Click"/>

                <Button x:Name="HistoryButton"
                    Content="Historial"
                    Width="110"
                    Height="34"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,0,10,0"
                    Click="HistoryButton_Click"/>

                <Button x:Name="BackToFormButton"
                    Content="Volver"
                    Width="110"
                    Height="34"
                    FontSize="16"
                    FontWeight="Bold"
                    Visibility="Collapsed"
                    Click="BackToFormButton_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">

            <views:ActFormView
                x:Name="ActForm"/>

            <controls:DocumentPreviewControl
                x:Name="DocumentPreview"
                Visibility="Collapsed"/>

        </Grid>

    </Grid>
</Window>