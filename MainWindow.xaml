<Window x:Class="ACTA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ACTA.Views"
        Title="ACTA"
        Width="1100"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16,10"
            BorderBrush="#D0D0D0"
            BorderThickness="0,0,0,1">

            <StackPanel Orientation="Horizontal">

                <Button
                    Content="Nueva acta"
                    Width="110"
                    Height="34"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,0,10,0"
                    Click="NewActButton_Click"/>

                <Button
                    Content="Historial"
                    Width="110"
                    Height="34"
                    FontSize="16"
                    FontWeight="Bold"
                    Click="HistoryButton_Click"/>

            </StackPanel>

        </Border>

        <views:ActFormView
            x:Name="ActForm"
            Grid.Row="1"/>

    </Grid>

</Window>